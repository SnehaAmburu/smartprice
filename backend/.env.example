# .env.example
# Copy this file to .env and fill in the actual values.
# Example API keys for external price services (replace with real keys).
AMAZON_API_KEY=your_amazon_api_key_here
FLIPKART_API_KEY=your_flipkart_api_key_here
MEESHO_API_KEY=your_meesho_api_key_here
SNAPDEAL_API_KEY=your_snapdeal_api_key_here

# Flask configuration (optional)
FLASK_ENV=development
FLASK_DEBUG=1
